# KPTRON Piping Solutions - Production Environment Variables
# All variables are optional; defaults are preconfigured for instant zero-setup production hosting.

# Optional: Custom backend API endpoint or webhook URL (e.g. https://api.yourdomain.com/quote)
# If left empty, the application automatically uses local /quote.php (on cPanel/Apache) 
# and falls back to FormSubmit.co for static hosting.
VITE_QUOTE_API_URL=

# Optional: Web3Forms access key (from https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=

# Commercial Notification Inbox
VITE_CONTACT_EMAIL=kptronpipingsolutionsinc@gmail.com
VITE_SALES_EMAIL=pvdevashi@gmail.com
VITE_WHATSAPP_NUMBER=919967616124
